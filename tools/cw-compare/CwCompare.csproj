<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CwCompare</RootNamespace>
    <AssemblyName>cw-compare</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Default: sibling of repo root is external/CodeWalker via submodule. Override: dotnet build -p:CodeWalkerRepoRoot=... -->
  <PropertyGroup>
    <CodeWalkerRepoRoot Condition="'$(CodeWalkerRepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\external\CodeWalker</CodeWalkerRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CodeWalkerRepoRoot)\CodeWalker.Core\CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
